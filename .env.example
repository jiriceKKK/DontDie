# DontDie — local development environment variables.
# Copy to .env (git-ignored) or, preferably, export these in your shell /
# secret manager / protected CI environment. Never commit real values.

# Discord webhook used ONLY by scripts/notify-phase.mjs (Node, server-side).
# It must never appear in js/, index.html, sw.js, tests, logs or documentation.
DONTDIE_DISCORD_WEBHOOK_URL=

# Disposable/staging Postgres (Supabase-compatible) connection string used by
# npm run db:verify to rehearse supabase/migrations + supabase/verify.
# Never point this at the production project.
DONTDIE_STAGING_DATABASE_URL=
